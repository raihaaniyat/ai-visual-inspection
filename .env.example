# ==============================================================================
# Visual Quality Inspection Platform Configuration
# ==============================================================================

# ---- Vision API Configuration (Required for Visual Inspection) ----
# Provide your Vision API key (kept server-side, never exposed to client)
GEMINI_API_KEY=your_api_key_here
# Optional fallback Vision API key (used automatically if primary hits quota or rate limits)
GEMINI_API_KEY_FALLBACK=your_fallback_api_key_here
# Configurable model identifier (e.g. gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# ---- Optional Security & Access Control for Public Deployment ----
# Leave empty for open access, or set a secret key to require X-Inspection-Key header
INSPECTION_API_KEY=
# Max allowed requests per minute per IP
RATE_LIMIT_PER_MINUTE=30
# Max upload payload size in bytes (default 4.0 MB for Vercel 4.5 MB limit)
MAX_UPLOAD_SIZE_BYTES=4194304

# ---- Storage & Database Persistence ----
# For production serverless deployments (Vercel), provide a PostgreSQL connection URL (e.g. from Supabase / Neon)
# e.g., postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=
# Or Supabase Project URL & API Key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_key_here
# Directory for local SQLite database, reference images, and inspection records (fallback)
INSPECTOR_STORAGE_DIR=./backend/data/assembly_storage

# ---- Image Comparison Verification (OpenCV) ----
OPENCV_DIFF_THRESHOLD=40
OPENCV_MIN_DEFECT_AREA=150

# ---- Local API Server ----
API_HOST=0.0.0.0
API_PORT=8000
